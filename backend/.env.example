# Which model provider the agent uses: "ollama" (free, local) or "anthropic" (Claude API, paid).
LLM_PROVIDER=ollama

# Ollama: the model must support tool calling (qwen2.5, llama3.1, mistral-nemo, ...).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Claude API: only read when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low

AGENT_MAX_STEPS=8
LLM_MAX_TOKENS=4096
